[mysqld]
user = mysql
datadir = /var/lib/mysql
socket = /run/mysqld/mysqld.sock
skip-networking

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
innodb_buffer_pool_size = 256M
# local disk is ephemeral, so fsync-on-commit buys nothing; what bounds data loss is the binlog
# reaching R2, which needs the binlog itself synced on every commit
innodb_flush_log_at_trx_commit = 2
sync_binlog = 1

server_id = 1
binlog_format = ROW
max_binlog_size = 16M
expire_logs_days = 2
